{
  "$id": "tern.match/1",
  "title": "A dating profile, posted as a small attachment to a dating community (sealed to its members, marked local-only). No names, no contacts, no photos: a photo and a contact go by sealed mail, after a mutual like, to that one person only. The rules a JSON Schema can't say (exactly one of age and age_range; no contacts, links or handles in the text; no mention of minors) are checked by matchtool (examples/match/match.go).",
  "type": "object",
  "required": ["schema", "adult", "region", "interests", "seeking"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "tern.match/1"},
    "adult": {"const": true, "description": "the person declares they are 18 or older"},
    "age": {"type": "integer", "minimum": 18, "maximum": 120},
    "age_range": {"enum": ["18-24", "25-29", "30-34", "35-39", "40-44", "45-49", "50-59", "60+"]},
    "region": {"type": "string", "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$", "description": "ISO 3166-1 country, or ISO 3166-2 subdivision: TR, TR-33 (Mersin), DE-BE (Berlin)"},
    "area": {"type": "string", "minLength": 1, "maxLength": 40, "description": "a city or a district, never a street or a workplace"},
    "gender": {"$ref": "#/$defs/word"},
    "languages": {"type": "array", "maxItems": 6, "items": {"type": "string", "pattern": "^[a-z]{2}$"}},
    "interests": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/tag"}},
    "seeking": {
      "type": "object",
      "required": ["age_min", "age_max", "intent"],
      "additionalProperties": false,
      "properties": {
        "genders": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/word"}},
        "age_min": {"type": "integer", "minimum": 18, "maximum": 120},
        "age_max": {"type": "integer", "minimum": 18, "maximum": 120},
        "intent": {"$ref": "#/$defs/intent"},
        "regions": {"type": "array", "maxItems": 8, "items": {"type": "string", "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"}},
        "text": {"type": "string", "maxLength": 200}
      }
    },
    "about": {"type": "string", "maxLength": 400}
  },
  "$defs": {
    "word": {"type": "string", "pattern": "^[a-z][a-z -]{0,29}$"},
    "tag": {"type": "string", "pattern": "^[a-z0-9][a-z0-9 -]{0,29}$"},
    "intent": {"enum": ["long-term", "short-term", "friends", "open"]},
    "prefs": {
      "$id": "tern.match.prefs/1",
      "title": "What a person tells their own agent (kept on their device, never posted): who to propose, what rules them out, how many likes a day",
      "type": "object",
      "required": ["schema", "age_min", "age_max"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "tern.match.prefs/1"},
        "age_min": {"type": "integer", "minimum": 18, "maximum": 120},
        "age_max": {"type": "integer", "minimum": 18, "maximum": 120},
        "genders": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/word"}},
        "regions": {"type": "array", "maxItems": 8, "items": {"type": "string", "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"}},
        "intents": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/intent"}},
        "likes": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/tag"}},
        "deal_breakers": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/tag"}},
        "min_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "daily_likes": {"type": "integer", "minimum": 1, "maximum": 10},
        "notes": {"type": "string", "maxLength": 500}
      }
    }
  }
}
