# /etc/tern/backup.env (mode 600), read by the tern-besu-* units.
TERN_NODE_DIR=/home/tern/tern/archive
TERN_RPC=http://127.0.0.1:8545
TERN_BACKUP_DIR=/var/backups/tern-besu
TERN_KEEP=7
TERN_METHOD=tar
TERNCHAIN=/usr/local/bin/ternchain
# TERN_CONTAINER=tern-1a2b3c4d          # default: from validator.json
# TERN_UNIT=besu-archive.service        # native Besu under systemd instead of Docker
# TERN_OFFSITE=backup@storage.example.org:/srv/tern-besu/
# For the restore test:
TERN_BOOTNODES_FILE=/etc/tern/bootnodes.txt
TERN_REF_RPC=http://127.0.0.1:8545
