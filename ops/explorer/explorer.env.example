# Copy to .env (mode 600) and fill in. docker compose reads it.
EXPLORER_HOST=explorer.example.org
PUBLIC_RPC_URL=https://rpc1.example.org
POSTGRES_PASSWORD=change-me-openssl-rand-hex-24
SECRET_KEY_BASE=change-me-openssl-rand-hex-64
# The archive node's PRIVATE RPC, as the containers see it (README).
ARCHIVE_RPC_HTTP=http://host.docker.internal:8545
ARCHIVE_RPC_WS=ws://host.docker.internal:8546
# "true" if the archive node has no TRACE API (no internal transactions then).
NO_TRACE=false
# Image tags: check and set the newest stable ones (not verified in this repo).
BLOCKSCOUT_TAG=8.0.0
FRONTEND_TAG=v2.0.0
SC_VERIFIER_TAG=v1.9.0
